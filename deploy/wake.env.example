# wake settings. Copy to ~/.config/wake/wake.env, chmod 0600, and edit.
# Every key can also be given as an environment variable with a WAKE_ prefix,
# which wins over this file.

# ---- both roles ----------------------------------------------------------
# "server" holds the authoritative database; "device" syncs against one.
# install.sh appends the role you chose to the bottom of this file.
#ROLE=device
# This machine's name, recorded on every task it creates. Defaults to hostname.
#ORIGIN=
#DB_PATH=~/.local/state/wake/wake.db
# Shared secret. The server checks it; devices send it as X-Wake-Key.
# Leave unset only if nothing untrusted can reach the port.
#API_KEY=

# ---- device --------------------------------------------------------------
# The server's base URL, e.g. its tailnet address.
#SERVER_URL=http://100.72.2.62:8788
# How often `wake agent` reconciles with the server.
#SYNC_SECONDS=60

# ---- server --------------------------------------------------------------
#BIND=0.0.0.0
#PORT=8788
# How often the firing loop looks for due tasks.
#POLL_SECONDS=5

# ---- backends ------------------------------------------------------------
# Where the notify and call backends reach hotline-ios.
#HOTLINE_IOS_URL=http://100.72.2.62:8789
#HOTLINE_IOS_KEY=
# Override the broadcast address the wol backend sends to. A per-task
# `--target <mac>@<address>` beats this.
#WOL_BROADCAST=255.255.255.255
