# The always-on half: holds the authoritative task database, answers the HTTP
# API, and fires every task no device has claimed.
#
# A user unit, like hotline-ios's, not a system one: wake serve needs no
# privileges it does not get as this user, and keeping it in the user manager
# means the database lives under $HOME with the rest of the operator's state.
# Settings are NOT passed through Environment= or EnvironmentFile= -- wake
# reads ~/.config/wake/wake.env itself, so the API key stays in one 0600 file
# instead of also sitting in `systemctl show` output.
#
# Do not copy this file into place by hand: @WAKE_ROOT@ below is a placeholder,
# not a path. deploy/install.sh substitutes the checkout it is installing from.
# It used to be a literal %h/data/wake, which was correct for exactly one
# checkout on one machine and failed as 203/EXEC anywhere else.
#
#   deploy/install.sh --role server

[Unit]
Description=wake: authoritative task database, HTTP API and firing loop
Documentation=https://github.com/BogdanStamenovic/wake
ConditionPathExists=%h/.config/wake/wake.env

# There is deliberately no network-online.target ordering here: that target does
# not exist in a user manager (LoadState=not-found), so depending on it is a
# silent no-op dressed up as a guarantee. `wake serve` does not need it anyway
# -- it binds a listening socket and does not reach out at startup.

[Service]
Type=simple
WorkingDirectory=@WAKE_ROOT@
ExecStart=@WAKE_ROOT@/.venv/bin/wake serve
# Creates ~/.local/state/wake before the unit starts. The database's parent
# directory has to exist as a real directory, not as a path wake happens to
# mkdir -p on first run, or a hardened unit fails at namespace setup instead.
StateDirectory=wake
Restart=on-failure
RestartSec=5
TimeoutStopSec=20

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictRealtime=true
RestrictSUIDSGID=true
ReadWritePaths=%h/.local/state/wake

[Install]
WantedBy=default.target
