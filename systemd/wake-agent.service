# The device half, for a machine that is usually up: syncs with the server on a
# period and fires the tasks addressed to this machine (`wake add --on <this>`).
#
# For a laptop that suspends, prefer wake-sync.timer instead -- see the note in
# that file. Nothing stops both being installed, but then both are syncing.
#
#   install -Dm644 systemd/wake-agent.service ~/.config/systemd/user/wake-agent.service
#   systemctl --user daemon-reload && systemctl --user enable --now wake-agent.service

[Unit]
Description=wake: sync with the server and fire this machine's own tasks
Documentation=https://github.com/BogdanStamenovic/wake
ConditionPathExists=%h/.config/wake/wake.env

# There is deliberately no network-online.target ordering here. That target
# does not exist in a user manager -- `systemctl --user show network-online.target`
# reports LoadState=not-found on this box -- so Wants=/After= on it is silently
# a no-op that reads like a guarantee. What actually makes this safe is that
# the sync treats an unreachable server as retryable: it logs and tries again
# next cycle rather than exiting.

[Service]
Type=simple
ExecStart=%h/data/wake/.venv/bin/wake agent
StateDirectory=wake
# The server being unreachable is logged and retried, not fatal, so a restart
# loop here means something structural -- a bad config, a missing venv.
Restart=on-failure
RestartSec=10
TimeoutStopSec=20

# This unit is deliberately UNSANDBOXED, unlike wake-server.service. It arms
# the RTC and powers the machine off, both through sudo, and every sandboxing
# directive available here breaks sudo in a different way:
#
#   NoNewPrivileges=true -> "the no new privileges flag is set, which prevents
#                           sudo from running as root"
#   PrivateTmp=true      -> in a *user* manager systemd implements sandboxing
#                           with an unprivileged user namespace, in which real
#                           root maps to nobody. sudo then reports
#                           "/etc/sudo.conf is owned by uid 65534, should be 0"
#                           and "/usr/bin/sudo must be owned by uid 0 and have
#                           the setuid bit set". Confirmed by comparing
#                           /proc/PID/ns/user against a normal shell.
#
# Both were found by rehearsal rather than by reading. A `systemd-run --user`
# check passed for the first one because transient units set neither flag --
# the test differed from the real unit in exactly the way that mattered.
# wake-server.service keeps its hardening: it never needs privileges.

[Install]
WantedBy=default.target
