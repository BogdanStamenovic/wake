# The laptop alternative to wake-agent.service.
#
# Prefer it there because each run is a fresh short-lived process: nothing
# holds a socket or a database handle across a suspend, and there is no daemon
# that can wedge in a way only a restart clears. It only syncs, though -- a
# device that must also *fire* its own tasks on time wants wake-agent.service,
# since a timer running every two minutes cannot honour an alarm to the second.
#
# There is deliberately no Persistent=true here, and that is not an oversight.
# It looks like it would make a laptop catch up on syncs missed while it was
# asleep, and every signal agrees: systemd accepts it and `systemctl show`
# reports Persistent=yes. But systemd.timer(5) is explicit that it "only has an
# effect on timers configured with OnCalendar=", and these triggers are
# monotonic. Verified on this box -- with the line, systemd writes a stamp
# under ~/.local/share/systemd/timers and never removes it, not even when the
# unit is disabled and deleted; without it, no stamp and identical behaviour.
# It bought nothing and leaked a file per install.
#
# What actually covers the gaps: OnBootSec= after a cold start, and monotonic
# time not advancing across a suspend, so a resumed laptop syncs within
# OnUnitActiveSec= of waking rather than skipping the windows it slept through.
#
#   install -Dm644 systemd/wake-sync.{service,timer} ~/.config/systemd/user/
#   systemctl --user daemon-reload && systemctl --user enable --now wake-sync.timer

[Unit]
Description=wake: sync with the server periodically
Documentation=https://github.com/BogdanStamenovic/wake

[Timer]
OnBootSec=1min
OnUnitActiveSec=2min
AccuracySec=15s

[Install]
WantedBy=timers.target
